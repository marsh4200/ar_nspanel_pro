<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Wi-Fi scan on the setup screen (Android 9+); granted by the device owner itself, never asked -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Intercom: live voice calls between panels (granted by the installer / device owner) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Granted by Home Assistant's installer over ADB (pm grant): lets the app
         keep USB / network debugging on when the panel's own software turns it off. -->
    <!-- Granted by Home Assistant's installer (appops): Android 10+ only lets an
         app open its screen from the boot receiver with this, which is how the
         panel starts after a reboot when another launcher (HDL) is Home. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Shelly Wall Display 2.6+ "AR on top" (ShellyWatch): a foreground service that
         sees when Shelly's screen comes to the front (usage access, allowed by HA's
         takeover with appops GET_USAGE_STATS) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Over-the-air updates (Updater.kt): the app installs its own new version.
         Silent when it is device owner (USB setup) or, on Android 12+, its own
         installer of record; otherwise Android asks once on screen. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Shelly Wall Display taken over: keep Android's auto-brightness and sleep
         timer off (Shelly.kt). Allowed by HA's takeover (appops WRITE_SETTINGS). -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+: the music page can open the Spotify app -->
    <queries>
        <package android:name="com.spotify.music" />
        <!-- Akubela panel: is this one (AkuOff) -->
        <package android:name="com.akubela.panel" />
        <!-- Shelly Wall Display: its own app, and its Home screen (Shelly.kt rescue) -->
        <package android:name="cloud.shelly.stargate" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/PanelTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets the config panel's ADB tool make this the panel's launcher (set_home). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Kiosk: Home Assistant makes the app device owner at install so it
             can lock itself in (no Home / Recents / Clear all on swipe up). -->
        <receiver
            android:name=".KioskAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <!-- Lock / unlock from HA's ADB tools; DUMP = only the ADB shell / system can send. -->
        <receiver
            android:name=".KioskControl"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="za.co.arsmarthome.nspanel.KIOSK_LOCK" />
                <action android:name="za.co.arsmarthome.nspanel.KIOSK_UNLOCK" />
                <action android:name="za.co.arsmarthome.nspanel.KIOSK_OWNER_ONLY" />
            </intent-filter>
        </receiver>

        <!-- Shelly Wall Display 2.6+: keeps the panel in front of Shelly's screen -->
        <service
            android:name=".ShellyWatch"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Wall panel kiosk: keeps the panel's own screen in front of the maker's app" />
        </service>

        <!-- Shelly Wall Display: HA's "Use AR app (Shelly off)" / "Back to Shelly screen"
             over ADB. DUMP = only the ADB shell / system can send. -->
        <receiver
            android:name=".ShellyControl"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="za.co.arsmarthome.nspanel.SHELLY_OFF" />
                <action android:name="za.co.arsmarthome.nspanel.SHELLY_ON" />
                <action android:name="za.co.arsmarthome.nspanel.SHELLY_ADB_PAIR" />
                <action android:name="za.co.arsmarthome.nspanel.SHELLY_BACK_DONE" />
            </intent-filter>
        </receiver>

        <!-- PackageInstaller's result for an over-the-air update (Updater.kt) -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
